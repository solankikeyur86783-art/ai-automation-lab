        "jsCode": "const raw = $input.first().json.choices[0].message.content;\nconst parsed = JSON.parse(raw);\nreturn [{\n  json: {\n    id: $('Save Lead').first().json.id,\n    score: parsed.score,\n    category: parsed.category,\n    reason: parsed.reason\n  }\n}];"
