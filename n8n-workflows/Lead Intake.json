        "jsonBody": "={\n  \"model\": \"openai/gpt-oss-20b\",\n  \"temperature\": 0.2,\n  \"response_format\": { \"type\": \"json_object\" },\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a B2B lead qualification assistant. Given a lead's details, respond ONLY with a JSON object with exactly these keys: score (integer 1-100, higher = more likely to convert), category (one of: hot, warm, cold), reason (one short sentence, under 20 words). No extra text.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Name: {{ $('Webhook1').item.json.body.name }}\\nCompany: {{ $('Webhook1').item.json.body.company || 'N/A' }}\\nMessage: {{ $('Webhook1').item.json.body.message }}\"\n    }\n  ]\n}",
